<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Thông tin sinh viên -->
    <TextView
        android:id="@+id/tvThongTinSV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SV: Trương Văn Quang\nMSSV: 2415053122232\nLớp: CNTT"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:textColor="#2196F3"/>

    <!-- Ô nhập liệu -->
    <EditText
        android:id="@+id/edtTenCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tên công việc"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/edtMoTa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập mô tả công việc"
        android:layout_marginBottom="24dp"/>

    <!-- Các nút chức năng -->
    <Button
        android:id="@+id/btnTaoCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tạo công việc"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnXemDanhSach"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xem danh sách công việc" />
</LinearLayout>